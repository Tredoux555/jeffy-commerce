{
  "manifest_version": 3,
  "name": "Jeffy 1688 Importer",
  "version": "1.0.0",
  "description": "Import products from 1688.com directly to Jeffy Commerce with automatic translation and image processing",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://detail.1688.com/*",
    "https://www.jeffy.co.za/*",
    "https://jeffy.co.za/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://detail.1688.com/*", "https://*.1688.com/offer/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
