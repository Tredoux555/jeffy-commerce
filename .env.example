# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://jeffy.co.za

# Email (Resend) — used for reseller login, returns, low-stock + Wish List winner notifications.
# If unset, all notifications silently no-op (safe for dev / pre-launch).
RESEND_API_KEY=re_xxxxxxxxxxxxx
NOTIFY_FROM_EMAIL=Jeffy <hello@jeffy.co.za>

# VAT — flip to true the day Jeffy is VAT-registered (turns on output-VAT tracking on the wholesale leg).
VAT_REGISTERED=false

# Wish List weekly draw cron — set a secret and schedule GET /api/cron/wishlist-draw with
# header  Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=

# Auto-graduation thresholds (consignment → buy_upfront). Defaults shown; tune as needed.
GRAD_MIN_SALES=10
GRAD_MIN_SALES_CENTS=500000
# Low-stock nudge fires when a reseller's stock-on-hand for a sold product drops to/below this.
LOW_STOCK_THRESHOLD=3

# Payments (PayFast)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Set true in production to reject webhook posts from non-PayFast IPs.
PAYFAST_ENFORCE_IP=false

# Payments (Ozow)
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_SANDBOX=true
